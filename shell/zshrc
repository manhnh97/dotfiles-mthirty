# Powerlevel10k instant prompt. Must stay at the top of this file.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Homebrew is also loaded from .zprofile for login shells. This covers the rest.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

# Per-machine PATH: JDKs, Android, nvm, grok. Not committed.
[[ -f "$HOME/.config/mthirty/local.zsh" ]] && source "$HOME/.config/mthirty/local.zsh"

# Paste stays fast. Long lines are not highlighted.
DISABLE_MAGIC_FUNCTIONS=true
export ZSH_AUTOSUGGEST_USE_ASYNC=1
export ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
typeset -g ZSH_HIGHLIGHT_MAXLENGTH=200

export EDITOR="${EDITOR:-nvim}"
export VISUAL="$EDITOR"
export GIT_EDITOR="$EDITOR"

# Oh My Zsh. Updates stay manual: run `omz update`.
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
if [[ -d "$ZSH" ]]; then
  ZSH_THEME="powerlevel10k/powerlevel10k"
  zstyle ':omz:update' mode disabled
  # A leading space keeps a command out of history.
  HISTSIZE=50000
  SAVEHIST=50000
  HIST_STAMPS="yyyy-mm-dd"
  setopt hist_ignore_all_dups

  plugins=(
    git
    sudo
    extract
    zsh-autosuggestions
  )
  source "$ZSH/oh-my-zsh.sh"
else
  HISTSIZE=50000
  SAVEHIST=50000
  setopt hist_ignore_all_dups hist_ignore_space share_history
fi

# This file lives in shell/, so two directories up is the repo.
DOTFILES="${${(%):-%x}:A:h:h}"
source "$DOTFILES/shell/aliases.zsh"
source "$DOTFILES/shell/functions.zsh"

export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --info=inline'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {}'"
if [[ -r /opt/homebrew/opt/fzf/shell/key-bindings.zsh ]]; then
  source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
  source /opt/homebrew/opt/fzf/shell/completion.zsh
fi

# `cd` learns the directories you actually use. `builtin cd` is the plain one.
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh --cmd cd)"
fi

if (( $+commands[direnv] )); then
  eval "$(direnv hook zsh)"
fi

source "$DOTFILES/shell/vimmode.zsh"

[[ ! -f "$DOTFILES/shell/p10k.zsh" ]] || source "$DOTFILES/shell/p10k.zsh"

# Syntax highlighting is sourced last on purpose.
if [[ -r "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
  source "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
